# Configure these as server-only variables in your Vercel project.
# Copy the PostgreSQL connection URL from your Prisma Postgres database.
DATABASE_URL=
JWT_SECRET=
CRON_SECRET=
APP_ENV=training
NODE_ENV=production
COOKIE_SAME_SITE=strict
NODEJS_HELPERS=0
# Exact deployed origin, e.g. https://your-project.vercel.app
WEB_ORIGIN=
PUBLIC_ORIGIN=
# Provisioning only. Not needed by the running application.
DIRECT_DATABASE_URL=
OWNER_USERNAME=Aravind
OWNER_PASSWORD=
