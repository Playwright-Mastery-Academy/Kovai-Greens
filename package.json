{
  "name": "kovai-greens",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:seed": "npm run db:seed -w apps/api",
    "db:deploy": "npm run db:deploy -w apps/api",
    "db:setup": "node scripts/prepare-database.mjs --sample",
    "local": "npm run db:generate && npm run build && node scripts/start-local.mjs"
  },
  "engines": {
    "node": "22.x"
  }
}
