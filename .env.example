COMPOSE_PROJECT_NAME=kovai-production
APP_ENV=production
POSTGRES_DB=kovai
POSTGRES_USER=kovai
# Generate unique hex secrets. Never reuse them for training.
POSTGRES_PASSWORD=
JWT_SECRET=
# Local compose only. Set production and an HTTPS origin for real deployment.
NODE_ENV=development
WEB_ORIGIN=http://localhost:8080
WEB_PORT=8080
# For local Node development outside Docker:
DATABASE_URL=postgresql://kovai:YOUR_PASSWORD@localhost:5432/kovai

# Reachable frontend/API origin used on printed package QR labels.
PUBLIC_ORIGIN=http://localhost:8080
