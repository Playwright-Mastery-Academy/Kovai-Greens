{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --include=dev",
  "functions": {
    "api/index.js": {
      "includeFiles": "{apps/api/dist/**,node_modules/.prisma/client/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/recurrence",
      "schedule": "0 0 * * *"
    }
  ],
  "env": {
    "APP_ENV": "production"
  }
}
