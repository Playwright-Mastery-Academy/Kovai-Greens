{
  "name": "@kovai/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "node --import tsx --test src/domain.test.ts src/database.test.ts src/store-availability.test.ts",
    "test:integration": "node --import tsx --test src/integration.test.ts",
    "test:http": "npm run build && node scripts/verify-api.mjs",
    "db:seed": "node --import tsx src/seed.ts",
    "test:sample": "npm run build && node scripts/verify-api.mjs --sample"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "prisma": "6.19.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
